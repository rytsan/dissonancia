<Project Sdk="Microsoft.NET.Sdk">
  <!-- DEV (tools/eval): Basic Pitch notes of WAV files, for the ruler's "basicpitch" system -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dissonancia</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../app/BasicPitch.cs" />
    <None Include="../../../app/models/basic-pitch-nmp.onnx" CopyToOutputDirectory="PreserveNewest" Link="models/basic-pitch-nmp.onnx" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>
</Project>

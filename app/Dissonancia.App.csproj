<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dissonancia</RootNamespace>
    <AssemblyName>Dissonancia</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />  <!-- LIVE Melodia's note transcriber (CPU) -->  <!-- 5.2+ moves to SkiaSharp 4.x; Avalonia 12 ships 3.119 -->
  </ItemGroup>

  <!-- Basic Pitch (Spotify, Apache-2.0): models/NOTICE. -->
  <ItemGroup>
    <None Include="models/**" CopyToOutputDirectory="PreserveNewest" Link="models/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Native core built by CMake in ../core/build (Linux .so, macOS .dylib, Windows .dll). -->
  <ItemGroup>
    <None Include="../core/build/*dissonancia.so;../core/build/*dissonancia.dylib;../core/build/**/dissonancia.dll"
          CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <!-- Verovio (LGPL-3.0, SCORE view): separate shared library + its font data, built by the core's CMake (DZ_WITH_VEROVIO). -->
  <ItemGroup>
    <None Include="../core/build/verovio/lib/*verovio.so;../core/build/verovio/lib/*verovio.dylib;../core/build/verovio/bin/*verovio.dll"
          CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Visible="false" />
    <None Include="../core/build/verovio/share/verovio/**/*" CopyToOutputDirectory="PreserveNewest"
          Link="verovio-data/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <!-- VST3 host helper (STUDIO S8, optional): plugins run in their own process. -->
  <ItemGroup>
    <None Include="../core/build/dz_plugi?;../core/build/dz_plugin.ex?" CopyToOutputDirectory="PreserveNewest"
          Link="%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <!-- Demucs separation helper (STUDIO S3, optional): run as its own process; weights downloaded on demand. -->
  <ItemGroup>
    <!-- Wildcards so a build without the helper simply copies nothing. -->
    <None Include="../core/build/dz_separat?;../core/build/dz_separate.ex?" CopyToOutputDirectory="PreserveNewest"
          Link="%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <!-- AI feedback helper (phase 3, optional): run as its own process on the user's GGUF; its worked examples beside it. -->
  <ItemGroup>
    <None Include="../core/build/bin/dz_coac?;../core/build/bin/dz_coach.ex?" CopyToOutputDirectory="PreserveNewest"
          Link="%(Filename)%(Extension)" Visible="false" />
    <!-- llama.cpp's libraries and ggml's backend plugins (CPU variants, CUDA, Vulkan: what this machine built). -->
    <None Include="../core/build/bin/libllama.so*;../core/build/bin/libggml*.so*;../core/build/bin/libllama*.dylib;../core/build/bin/libggml*.dylib;../core/build/bin/llam?.dll;../core/build/bin/ggml*.dll"
          CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Visible="false" />
    <None Include="../core/coach/examples/*" CopyToOutputDirectory="PreserveNewest"
          Link="coach/examples/%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

</Project>

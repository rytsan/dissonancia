<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dissonancia</RootNamespace>
    <AssemblyName>Dissonancia</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>

  <!-- Native core built by CMake in ../core/build (Linux .so, macOS .dylib, Windows .dll). -->
  <ItemGroup>
    <None Include="../core/build/*dissonancia.so;../core/build/*dissonancia.dylib;../core/build/**/dissonancia.dll"
          CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runnable check for the SCORE layer (quantization, ties, writers): dotnet run -project tests/score -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dissonancia</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../app/Score.cs;../../app/Theory.cs;../../app/Verovio.cs;../../app/RackCatalog.cs;../../app/EditList.cs;../../app/LeadSheet.cs;../../app/Review.cs;../../app/StudioPlugins.cs;../../app/LiveSong.cs;../../app/StudioSeparation.cs;../../app/TorchCheckpoint.cs;../../app/StudioMix.cs;../../app/Playground.cs;../../app/SongMidi.cs;../../app/SampleBank.cs;../../app/Accel.cs;../../app/BasicPitch.cs;../../app/YourMt3.cs;../../app/TakeReport.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />  <!-- Playground.cs -> Setup (Accel.cs) -->
  </ItemGroup>
  <!-- Verovio import check runs when the core was built with DZ_WITH_VEROVIO (skipped otherwise). -->
  <ItemGroup>
    <None Include="../../core/build/verovio/lib/*verovio.so;../../core/build/verovio/lib/*verovio.dylib;../../core/build/verovio/bin/*verovio.dll"
          CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Visible="false" />
    <None Include="../../core/build/verovio/share/verovio/**/*" CopyToOutputDirectory="PreserveNewest"
          Link="verovio-data/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>
</Project>
